<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-scenariy" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-scenariy">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-scenariy" />
<bpmn:participant id="pool-client" name="Клиент" processRef="proc-client-scenariy" />
<bpmn:messageFlow id="msg-0" name="сценарии" sourceRef="p3-send" targetRef="p3-cl" />
<bpmn:messageFlow id="msg-1" name="ответ" sourceRef="p3-cl" targetRef="p3-send" />
</bpmn:collaboration>
<bpmn:process id="proc-scenariy" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-upravlenie" name="Управление · сейчас Андрей">
<bpmn:flowNodeRef>p3-risk</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-kachestvo" name="Продукт и качество · сейчас София">
<bpmn:flowNodeRef>p3-den</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-priemka</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-gw-pr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-gw-risk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-risk-j</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-sof</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-gw-pered</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-proizvodstvo" name="Производство · сейчас Настя">
<bpmn:flowNodeRef>p3-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-plan</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-hooks</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-scen</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-tz</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-gw-cl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-send</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-gw-otv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-odobr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-gwp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-end-pachka</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-gw-period</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p3-end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p3-start" name="Аватары утверждены"><bpmn:documentation>из процесса 2</bpmn:documentation><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p3-plan" name="Взять из плана: сколько роликов на неделю"><bpmn:documentation>план выкладки из процесса 1</bpmn:documentation><bpmn:incoming>flow-0</bpmn:incoming><bpmn:incoming>flow-25</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p3-hooks" name="Хуки и заголовки на неделю"><bpmn:documentation>правило 09.09: 20 хуков</bpmn:documentation><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p3-scen" name="Сценарии на неделю вперед"><bpmn:documentation>все сразу не пишем</bpmn:documentation><bpmn:incoming>flow-2</bpmn:incoming><bpmn:incoming>flow-8</bpmn:incoming><bpmn:incoming>flow-20</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p3-tz" name="ТЗ на монтаж к каждому сценарию"><bpmn:documentation>пишет тот, кто пишет сценарии</bpmn:documentation><bpmn:incoming>flow-3</bpmn:incoming><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="p3-den" name="День утверждений"><bpmn:documentation>пн, ср, пт</bpmn:documentation><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing><bpmn:timerEventDefinition id="timer-p3-den" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="p3-priemka" name="Принять пачку сценариев"><bpmn:documentation>вне этих дней: ошибка планирования</bpmn:documentation><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p3-gw-pr" name="Принято?"><bpmn:incoming>flow-6</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing><bpmn:outgoing>flow-8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p3-gw-risk" name="Рискованные утверждения?"><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-9</bpmn:outgoing><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p3-risk" name="Утвердить формулировки вдвоем с Софией"><bpmn:documentation>здоровье, доход, конкуренты</bpmn:documentation><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p3-risk-j" name=""><bpmn:incoming>flow-10</bpmn:incoming><bpmn:incoming>flow-11</bpmn:incoming><bpmn:outgoing>flow-12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p3-gw-cl" name="Показываем клиенту?"><bpmn:incoming>flow-12</bpmn:incoming><bpmn:outgoing>flow-13</bpmn:outgoing><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="p3-send" name="Отправить первые сценарии в чат клиента"><bpmn:documentation>мелкие правки Настя вносит сама</bpmn:documentation><bpmn:incoming>flow-13</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="p3-gw-otv" name="Ответ?"><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing><bpmn:outgoing>flow-17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p3-sof" name="Подключиться и объяснить клиенту"><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-18</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p3-gw-pered" name="Нужна переделка?"><bpmn:incoming>flow-18</bpmn:incoming><bpmn:outgoing>flow-19</bpmn:outgoing><bpmn:outgoing>flow-20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p3-odobr" name="Отметка «одобрено» в таблице"><bpmn:documentation>кто ставит: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-14</bpmn:incoming><bpmn:incoming>flow-17</bpmn:incoming><bpmn:incoming>flow-19</bpmn:incoming><bpmn:outgoing>flow-21</bpmn:outgoing></bpmn:userTask>
<bpmn:parallelGateway id="p3-gwp" name=""><bpmn:incoming>flow-21</bpmn:incoming><bpmn:outgoing>flow-22</bpmn:outgoing><bpmn:outgoing>flow-23</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:endEvent id="p3-end-pachka" name="Пачка одобрена"><bpmn:documentation>→ процесс 4</bpmn:documentation><bpmn:incoming>flow-22</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="p3-gw-period" name="Период покрыт?"><bpmn:incoming>flow-23</bpmn:incoming><bpmn:outgoing>flow-24</bpmn:outgoing><bpmn:outgoing>flow-25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p3-end" name="Сценарии на период"><bpmn:incoming>flow-24</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="p3-start" targetRef="p3-plan" />
<bpmn:sequenceFlow id="flow-1" sourceRef="p3-plan" targetRef="p3-hooks" />
<bpmn:sequenceFlow id="flow-2" sourceRef="p3-hooks" targetRef="p3-scen" />
<bpmn:sequenceFlow id="flow-3" sourceRef="p3-scen" targetRef="p3-tz" />
<bpmn:sequenceFlow id="flow-4" sourceRef="p3-tz" targetRef="p3-den" />
