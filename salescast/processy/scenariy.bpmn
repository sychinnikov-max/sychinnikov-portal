<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-scenariy" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-scenariy">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-scenariy" />
<bpmn:participant id="pool-client" name="Клиент" processRef="proc-client-scenariy" />
<bpmn:messageFlow id="msg-0" name="сценарии на согласование" sourceRef="task-send-s" targetRef="task-client-s" />
<bpmn:messageFlow id="msg-1" name="ответ клиента" sourceRef="task-client-s" targetRef="task-send-s" />
</bpmn:collaboration>
<bpmn:process id="proc-scenariy" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-andrei" name="Андрей · управление">
<bpmn:flowNodeRef>start-nisha</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-reglament</bpmn:flowNodeRef>
<bpmn:flowNodeRef>catch-sla</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-eskal</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-analiz</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-cycle</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end-scen</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-sofia" name="София · качество">
<bpmn:flowNodeRef>task-ok-hooks</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-hooks</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-priemka</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-priemka</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-send-s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-client-s</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-nastya" name="Настя · производство">
<bpmn:flowNodeRef>task-baza</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-ref</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-klod</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-hooks</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-scen</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-integr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-peredat</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start-nisha" name="Клиент заведен, ниша известна"><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="task-reglament" name="Дать регламент подбора референсов (куда идти, что искать)"><bpmn:incoming>flow-0</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-baza" name="Собрать базу знаний ниши (хуки, фактура, интеграции)"><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-ref" name="Собрать референсы в таблицу с градацией (50 шт, ссылка + «беру / не беру»)"><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-klod" name="Обучить проект в Клоде, один чат (чат внутри проекта не менять)"><bpmn:incoming>flow-3</bpmn:incoming><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-hooks" name="Дать 20 хуков на утверждение (правило от 09.09)"><bpmn:incoming>flow-4</bpmn:incoming><bpmn:incoming>flow-8</bpmn:incoming><bpmn:incoming>flow-22</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-ok-hooks" name="Утвердить хуки (срок 1 день)"><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-hooks" name="Хуки ок?"><bpmn:incoming>flow-6</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing><bpmn:outgoing>flow-8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="task-scen" name="Написать сценарии по одобренным хукам (30 шт ≈ 1,5 ч)"><bpmn:incoming>flow-7</bpmn:incoming><bpmn:incoming>flow-15</bpmn:incoming><bpmn:incoming>flow-18</bpmn:incoming><bpmn:outgoing>flow-9</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-integr" name="Чередовать пять вариантов интеграции (правило Филиппа)"><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-priemka" name="Принять пачку сценариев (узкое горлышко: 3 дня простоя)"><bpmn:incoming>flow-10</bpmn:incoming><bpmn:incoming>flow-13</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="catch-sla" name="Сутки без ответа (таймер в CRM)"><bpmn:outgoing>flow-12</bpmn:outgoing><bpmn:timerEventDefinition id="timer-catch-sla" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="task-eskal" name="Поднять просрочку и разблокировать"><bpmn:incoming>flow-12</bpmn:incoming><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-priemka" name="Принято?"><bpmn:incoming>flow-11</bpmn:incoming><bpmn:outgoing>flow-14</bpmn:outgoing><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="task-send-s" name="Согласовать сценарии с клиентом"><bpmn:incoming>flow-14</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="gw-client-s" name="Утвердил?"><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-17</bpmn:outgoing><bpmn:outgoing>flow-18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="task-peredat" name="Передать сценарии в оживление (пачка 20 на тест)"><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-19</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="task-analiz" name="Разобрать залетевшие ролики (тестовый цикл по 20)"><bpmn:incoming>flow-19</bpmn:incoming><bpmn:outgoing>flow-20</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-cycle" name="Объем закрыт?"><bpmn:incoming>flow-20</bpmn:incoming><bpmn:outgoing>flow-21</bpmn:outgoing><bpmn:outgoing>flow-22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="end-scen" name="Объем месяца сдан"><bpmn:incoming>flow-21</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="start-nisha" targetRef="task-reglament" />
<bpmn:sequenceFlow id="flow-1" sourceRef="task-reglament" targetRef="task-baza" />
<bpmn:sequenceFlow id="flow-2" sourceRef="task-baza" targetRef="task-ref" />
<bpmn:sequenceFlow id="flow-3" sourceRef="task-ref" targetRef="task-klod" />
<bpmn:sequenceFlow id="flow-4" sourceRef="task-klod" targetRef="task-hooks" />
<bpmn:sequenceFlow id="flow-5" sourceRef="task-hooks" targetRef="task-ok-hooks" />
<bpmn:sequenceFlow id="flow-6" sourceRef="task-ok-hooks" targetRef="gw-hooks" />
<bpmn:sequenceFlow id="flow-7" name="да" sourceRef="gw-hooks" targetRef="task-scen" />
<bpmn:sequenceFlow id="flow-8" name="нет, новые хуки" sourceRef="gw-hooks" targetRef="task-hooks" />
<bpmn:sequenceFlow id="flow-9" sourceRef="task-scen" targetRef="task-integr" />
<bpmn:sequenceFlow id="flow-10" sourceRef="task-integr" targetRef="task-priemka" />
<bpmn:sequenceFlow id="flow-11" sourceRef="task-priemka" targetRef="gw-priemka" />
<bpmn:sequenceFlow id="flow-12" sourceRef="catch-sla" targetRef="task-eskal" />
<bpmn:sequenceFlow id="flow-13" name="вернуть в работу" sourceRef="task-eskal" targetRef="task-priemka" />
<bpmn:sequenceFlow id="flow-14" name="да" sourceRef="gw-priemka" targetRef="task-send-s" />
<bpmn:sequenceFlow id="flow-15" name="правки" sourceRef="gw-priemka" targetRef="task-scen" />
<bpmn:sequenceFlow id="flow-16" sourceRef="task-send-s" targetRef="gw-client-s" />
<bpmn:sequenceFlow id="flow-17" name="да" sourceRef="gw-client-s" targetRef="task-peredat" />
<bpmn:sequenceFlow id="flow-18" name="правки" sourceRef="gw-client-s" targetRef="task-scen" />
<bpmn:sequenceFlow id="flow-19" sourceRef="task-peredat" targetRef="task-analiz" />
<bpmn:sequenceFlow id="flow-20" sourceRef="task-analiz" targetRef="gw-cycle" />
<bpmn:sequenceFlow id="flow-21" name="да" sourceRef="gw-cycle" targetRef="end-scen" />
<bpmn:sequenceFlow id="flow-22" name="нет, новая пачка" sourceRef="gw-cycle" targetRef="task-hooks" />
</bpmn:process>
<bpmn:process id="proc-client-scenariy" isExecutable="false">
<bpmn:task id="task-client-s" name="Дать правки или утвердить" />
</bpmn:process>
