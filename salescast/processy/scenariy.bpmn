<bpmn:sequenceFlow id="flow-6" sourceRef="p3-priemka" targetRef="p3-gw-pr" />
<bpmn:sequenceFlow id="flow-7" name="да" sourceRef="p3-gw-pr" targetRef="p3-gw-risk" />
<bpmn:sequenceFlow id="flow-8" name="правки" sourceRef="p3-gw-pr" targetRef="p3-scen" />
<bpmn:sequenceFlow id="flow-9" name="да" sourceRef="p3-gw-risk" targetRef="p3-risk" />
<bpmn:sequenceFlow id="flow-10" name="нет" sourceRef="p3-gw-risk" targetRef="p3-risk-j" />
<bpmn:sequenceFlow id="flow-11" sourceRef="p3-risk" targetRef="p3-risk-j" />
<bpmn:sequenceFlow id="flow-12" sourceRef="p3-risk-j" targetRef="p3-gw-cl" />
<bpmn:sequenceFlow id="flow-13" name="первые 2-3" sourceRef="p3-gw-cl" targetRef="p3-send" />
<bpmn:sequenceFlow id="flow-14" name="нет" sourceRef="p3-gw-cl" targetRef="p3-odobr" />
<bpmn:sequenceFlow id="flow-15" sourceRef="p3-send" targetRef="p3-gw-otv" />
<bpmn:sequenceFlow id="flow-16" name="все плохо" sourceRef="p3-gw-otv" targetRef="p3-sof" />
<bpmn:sequenceFlow id="flow-17" name="утвердил" sourceRef="p3-gw-otv" targetRef="p3-odobr" />
<bpmn:sequenceFlow id="flow-18" sourceRef="p3-sof" targetRef="p3-gw-pered" />
<bpmn:sequenceFlow id="flow-19" name="нет" sourceRef="p3-gw-pered" targetRef="p3-odobr" />
<bpmn:sequenceFlow id="flow-20" name="да" sourceRef="p3-gw-pered" targetRef="p3-scen" />
<bpmn:sequenceFlow id="flow-21" sourceRef="p3-odobr" targetRef="p3-gwp" />
<bpmn:sequenceFlow id="flow-22" sourceRef="p3-gwp" targetRef="p3-end-pachka" />
<bpmn:sequenceFlow id="flow-23" sourceRef="p3-gwp" targetRef="p3-gw-period" />
<bpmn:sequenceFlow id="flow-24" name="да" sourceRef="p3-gw-period" targetRef="p3-end" />
<bpmn:sequenceFlow id="flow-25" name="нет, следующая неделя" sourceRef="p3-gw-period" targetRef="p3-plan" />
</bpmn:process>
<bpmn:process id="proc-client-scenariy" isExecutable="false">
<bpmn:task id="p3-cl" name="Утвердить или дать обратную связь" />
</bpmn:process>
