<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-prodazha" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-prodazha">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-prodazha" />
<bpmn:participant id="pool-client" name="Клиент" processRef="proc-client-prodazha" />
<bpmn:messageFlow id="msg-0" name="встреча" sourceRef="p0-vstrecha" targetRef="p0-cl-vstr" />
<bpmn:messageFlow id="msg-1" name="КП" sourceRef="p0-send-kp" targetRef="p0-cl-kp" />
<bpmn:messageFlow id="msg-2" name="ответ" sourceRef="p0-cl-kp" targetRef="p0-send-kp" />
<bpmn:messageFlow id="msg-3" name="договор и счет" sourceRef="p0-send-dog" targetRef="p0-cl-dog" />
<bpmn:messageFlow id="msg-4" name="ответ" sourceRef="p0-cl-dog" targetRef="p0-send-dog" />
<bpmn:messageFlow id="msg-5" name="напоминание" sourceRef="p0-napomn" targetRef="p0-cl-opl" />
</bpmn:collaboration>
<bpmn:process id="proc-prodazha" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-menedzher" name="Менеджер клиента · сейчас Андрей">
<bpmn:flowNodeRef>p0-napomn</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-srok2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-gw-opl2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-end-net</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-upravlenie" name="Управление · сейчас Андрей">
<bpmn:flowNodeRef>p0-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-kval</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-gw-kval</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-end-ne</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-moshch</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-nisha</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-kp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-cena</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-send-kp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-gw-kp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-start-prod</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-end-otkaz</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-dogovor</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-podpis</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-send-dog</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-gw-pravki</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-srok-opl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-gw-opl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-podtv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-uchet</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-kachestvo" name="Продукт и качество · сейчас София">
<bpmn:flowNodeRef>p0-vstrecha</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-sroki</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p0-proverka</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p0-start" name="Лид: заявка или знакомство"><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p0-kval" name="Квалифицировать клиента"><bpmn:documentation>покупатель, куда трафик, бюджет</bpmn:documentation><bpmn:incoming>flow-0</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p0-gw-kval" name="Подходит?"><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p0-end-ne" name="Не берем, причину говорим"><bpmn:incoming>flow-3</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="p0-vstrecha" name="Встреча с записью: задача, продукт, сомнения"><bpmn:documentation>запись настраивает Андрей</bpmn:documentation><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="p0-sroki" name="Заложить в сроки две недели подготовки"><bpmn:documentation>созвон с Софией 15.09</bpmn:documentation><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p0-moshch" name="Проверить место в команде"><bpmn:documentation>по оценке Софии еще двух клиентов не выдержим</bpmn:documentation><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p0-nisha" name="Разобрать нишу вдвоем: законность, пометка ИИ"><bpmn:documentation>поставить пометку ИИ не проблема</bpmn:documentation><bpmn:incoming>flow-6</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p0-kp" name="Собрать КП: образы, заголовки, пример сценария"><bpmn:documentation>кто готовит: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-8</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p0-cena" name="Утвердить цену и состав вдвоем"><bpmn:documentation>без согласия сделка не начинается</bpmn:documentation><bpmn:incoming>flow-8</bpmn:incoming><bpmn:outgoing>flow-9</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="p0-send-kp" name="Отправить КП, ответить на вопросы"><bpmn:documentation>одна цена за систему</bpmn:documentation><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="p0-gw-kp" name="Берет?"><bpmn:incoming>flow-10</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing><bpmn:outgoing>flow-12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:startEvent id="p0-start-prod" name="Продление"><bpmn:documentation>из процесса 7</bpmn:documentation><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:startEvent>
<bpmn:endEvent id="p0-end-otkaz" name="Отказ"><bpmn:incoming>flow-12</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="p0-dogovor" name="Договор: ролики, даты старта и конца, подготовка"><bpmn:documentation>вход для плана выкладки</bpmn:documentation><bpmn:incoming>flow-11</bpmn:incoming><bpmn:incoming>flow-13</bpmn:incoming><bpmn:incoming>flow-18</bpmn:incoming><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p0-proverka" name="Проверить и поправить договор"><bpmn:documentation>статусы документа, 09.09</bpmn:documentation><bpmn:incoming>flow-14</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p0-podpis" name="Подписать со стороны исполнителя"><bpmn:documentation>партнер, на чье юрлицо договор</bpmn:documentation><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="p0-send-dog" name="Отправить договор и счет, получить ответ"><bpmn:documentation>предоплата по договору</bpmn:documentation><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-17</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="p0-gw-pravki" name="Правки к договору?"><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-18</bpmn:outgoing><bpmn:outgoing>flow-19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="p0-srok-opl" name="Срок оплаты"><bpmn:documentation>по договору</bpmn:documentation><bpmn:incoming>flow-19</bpmn:incoming><bpmn:outgoing>flow-20</bpmn:outgoing><bpmn:timerEventDefinition id="timer-p0-srok-opl" /></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="p0-gw-opl" name="Оплачено?"><bpmn:incoming>flow-20</bpmn:incoming><bpmn:outgoing>flow-21</bpmn:outgoing><bpmn:outgoing>flow-22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="p0-napomn" name="Напомнить клиенту об оплате"><bpmn:documentation>кто и сколько раз: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-22</bpmn:incoming><bpmn:outgoing>flow-23</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="p0-srok2" name="Новый срок"><bpmn:incoming>flow-23</bpmn:incoming><bpmn:outgoing>flow-24</bpmn:outgoing><bpmn:timerEventDefinition id="timer-p0-srok2" /></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="p0-gw-opl2" name="Оплачено?"><bpmn:incoming>flow-24</bpmn:incoming><bpmn:outgoing>flow-25</bpmn:outgoing><bpmn:outgoing>flow-26</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p0-end-net" name="Оплаты нет"><bpmn:documentation>до оплаты не начинаем</bpmn:documentation><bpmn:incoming>flow-26</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="p0-podtv" name="Подтвердить поступление денег"><bpmn:documentation>как узнаем: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-21</bpmn:incoming><bpmn:incoming>flow-25</bpmn:incoming><bpmn:outgoing>flow-27</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p0-uchet" name="Сделка «оплачен» в CRM, операция в отчет о деньгах"><bpmn:documentation>отчет ведет Андрей с первой оплаты</bpmn:documentation><bpmn:incoming>flow-27</bpmn:incoming><bpmn:outgoing>flow-28</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p0-end" name="Деньги пришли"><bpmn:documentation>→ процесс 1</bpmn:documentation><bpmn:incoming>flow-28</bpmn:incoming></bpmn:endEvent>
