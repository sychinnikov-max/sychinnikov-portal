<bpmn:sequenceFlow id="flow-25" name="да" sourceRef="p0-gw-opl2" targetRef="p0-podtv" />
<bpmn:sequenceFlow id="flow-26" name="нет" sourceRef="p0-gw-opl2" targetRef="p0-end-net" />
<bpmn:sequenceFlow id="flow-27" sourceRef="p0-podtv" targetRef="p0-uchet" />
<bpmn:sequenceFlow id="flow-28" sourceRef="p0-uchet" targetRef="p0-end" />
</bpmn:process>
