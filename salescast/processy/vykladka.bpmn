<bpmn:sequenceFlow id="flow-4" sourceRef="p6-vylozhit" targetRef="p6-gw-akk" />
<bpmn:sequenceFlow id="flow-5" name="да" sourceRef="p6-gw-akk" targetRef="p6-akk-j" />
<bpmn:sequenceFlow id="flow-6" name="нет" sourceRef="p6-gw-akk" targetRef="p6-blok" />
<bpmn:sequenceFlow id="flow-7" sourceRef="p6-blok" targetRef="p6-zamena" />
<bpmn:sequenceFlow id="flow-8" sourceRef="p6-zamena" targetRef="p6-gwp-z" />
<bpmn:sequenceFlow id="flow-9" sourceRef="p6-gwp-z" targetRef="p6-novyi" />
<bpmn:sequenceFlow id="flow-10" sourceRef="p6-gwp-z" targetRef="p6-voronka" />
<bpmn:sequenceFlow id="flow-11" sourceRef="p6-voronka" targetRef="p6-v-end" />
<bpmn:sequenceFlow id="flow-12" sourceRef="p6-novyi" targetRef="p6-akk-j" />
<bpmn:sequenceFlow id="flow-13" sourceRef="p6-akk-j" targetRef="p6-otchet" />
<bpmn:sequenceFlow id="flow-14" sourceRef="p6-otchet" targetRef="p6-sverka" />
<bpmn:sequenceFlow id="flow-15" sourceRef="p6-sverka" targetRef="p6-gw-plan" />
<bpmn:sequenceFlow id="flow-16" name="да" sourceRef="p6-gw-plan" targetRef="p6-plan-j" />
<bpmn:sequenceFlow id="flow-17" name="нет: написать Андрею" sourceRef="p6-gw-plan" targetRef="p6-otkl" />
<bpmn:sequenceFlow id="flow-18" sourceRef="p6-otkl" targetRef="p6-plan-j" />
<bpmn:sequenceFlow id="flow-19" sourceRef="p6-plan-j" targetRef="p6-gw-obem" />
<bpmn:sequenceFlow id="flow-20" name="да" sourceRef="p6-gw-obem" targetRef="p6-end" />
<bpmn:sequenceFlow id="flow-21" name="нет, следующий день" sourceRef="p6-gw-obem" targetRef="p6-den-j" />
</bpmn:process>
