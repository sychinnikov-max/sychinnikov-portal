<bpmn:collaboration id="collab-vykladka">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-vykladka" />
</bpmn:collaboration>
<bpmn:process id="proc-vykladka" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-upravlenie" name="Управление · сейчас Андрей">
<bpmn:flowNodeRef>p6-zamena</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-gwp-z</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-otkl</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-proizvodstvo" name="Производство · сейчас Настя">
<bpmn:flowNodeRef>p6-sverka</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-gw-plan</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-plan-j</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-gw-obem</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-tekhspec" name="Техспец воронок · сейчас Владимир">
<bpmn:flowNodeRef>p6-voronka</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-v-end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-pub" name="Публикаторы · свои под проект">
<bpmn:flowNodeRef>p6-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-den-j</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-den</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-vzyat</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-vylozhit</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-gw-akk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-blok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-novyi</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-akk-j</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p6-otchet</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p6-start" name="Старт выкладки по плану"><bpmn:documentation>дата из процесса 1</bpmn:documentation><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="p6-den-j" name=""><bpmn:incoming>flow-0</bpmn:incoming><bpmn:incoming>flow-21</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="p6-den" name="День выкладки"><bpmn:documentation>по плану</bpmn:documentation><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing><bpmn:timerEventDefinition id="timer-p6-den" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="p6-vzyat" name="Взять ролики дня из папки"><bpmn:documentation>сейчас из рабочего чата</bpmn:documentation><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p6-vylozhit" name="Выложить ролики по плановым датам"><bpmn:documentation>на тесте одна публикация в день</bpmn:documentation><bpmn:incoming>flow-3</bpmn:incoming><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p6-gw-akk" name="Аккаунты работают?"><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p6-blok" name="Сообщить о блокировке"><bpmn:documentation>устройство больше не используем</bpmn:documentation><bpmn:incoming>flow-6</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p6-zamena" name="Решить замену аккаунта, задача техспецу"><bpmn:documentation>кто и в какой срок: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-8</bpmn:outgoing></bpmn:userTask>
<bpmn:parallelGateway id="p6-gwp-z" name=""><bpmn:incoming>flow-8</bpmn:incoming><bpmn:outgoing>flow-9</bpmn:outgoing><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:userTask id="p6-novyi" name="Новый аккаунт: создать, упаковать, прогреть"><bpmn:documentation>своя почта, свое устройство</bpmn:documentation><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-12</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p6-voronka" name="Почистить воронку заблокированного аккаунта"><bpmn:documentation>как часто проверять: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-10</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p6-v-end" name="Воронка почищена"><bpmn:incoming>flow-11</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="p6-akk-j" name=""><bpmn:incoming>flow-5</bpmn:incoming><bpmn:incoming>flow-12</bpmn:incoming><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p6-otchet" name="Отчет за день, ссылки в «Выкладка факт»"><bpmn:documentation>к какому часу: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-13</bpmn:incoming><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p6-sverka" name="Сверить факт выкладки с планом"><bpmn:documentation>созвон с Настей 15.09</bpmn:documentation><bpmn:incoming>flow-14</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p6-gw-plan" name="По плану?"><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing><bpmn:outgoing>flow-17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p6-otkl" name="Разобрать отклонение, настроить роль"><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-18</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p6-plan-j" name=""><bpmn:incoming>flow-16</bpmn:incoming><bpmn:incoming>flow-18</bpmn:incoming><bpmn:outgoing>flow-19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p6-gw-obem" name="Объем выложен?"><bpmn:incoming>flow-19</bpmn:incoming><bpmn:outgoing>flow-20</bpmn:outgoing><bpmn:outgoing>flow-21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p6-end" name="Объем по договору выложен"><bpmn:documentation>→ процесс 7</bpmn:documentation><bpmn:incoming>flow-20</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="p6-start" targetRef="p6-den-j" />
<bpmn:sequenceFlow id="flow-1" sourceRef="p6-den-j" targetRef="p6-den" />
