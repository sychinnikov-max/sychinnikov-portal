<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-start" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-start">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-start" />
<bpmn:participant id="pool-client" name="Клиент" processRef="proc-client-start" />
<bpmn:messageFlow id="msg-0" name="уточнения" sourceRef="p1-brif" targetRef="p1-cl" />
<bpmn:messageFlow id="msg-1" name="ответы" sourceRef="p1-cl" targetRef="p1-brif" />
<bpmn:messageFlow id="msg-2" name="тема квиза" sourceRef="p1-kviz" targetRef="p1-cl-kviz" />
<bpmn:messageFlow id="msg-3" name="варианты" sourceRef="p1-cl-kviz" targetRef="p1-kviz" />
</bpmn:collaboration>
<bpmn:process id="proc-start" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-menedzher" name="Менеджер клиента · сейчас Андрей">
<bpmn:flowNodeRef>p1-chat</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-brif</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-upravlenie" name="Управление · сейчас Андрей">
<bpmn:flowNodeRef>p1-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-k-sofii</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-utv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-gwp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-poisk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-v-gw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-gotov</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-kachestvo" name="Продукт и качество · сейчас София">
<bpmn:flowNodeRef>p1-spisok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-kviz</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-tekhspec" name="Техспец воронок · сейчас Владимир">
<bpmn:flowNodeRef>p1-teh</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-v-j</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-pub" name="Публикаторы · свои под проект">
<bpmn:flowNodeRef>p1-akk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-upak</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-progrev</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-proizvodstvo" name="Производство · сейчас Настя">
<bpmn:flowNodeRef>p1-plan</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-mod</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-scen</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-gwp-j</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p1-pervye</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p1-start" name="Деньги пришли"><bpmn:documentation>из процесса 0</bpmn:documentation><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p1-chat" name="Завести клиента в работу, общий чат"><bpmn:documentation>Андрей, София, Настя на подхвате</bpmn:documentation><bpmn:incoming>flow-0</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-k-sofii" name="Попросить у Софии список для старта"><bpmn:documentation>созвон с Настей 15.09</bpmn:documentation><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-spisok" name="Список старта по шаблону запуска в CRM"><bpmn:documentation>карточка «собрать инфу от клиента»</bpmn:documentation><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="p1-brif" name="Бриф из записей встреч, контекст в одно место"><bpmn:documentation>кто собирает: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-3</bpmn:incoming><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="p1-plan" name="Составить план выкладки на весь период"><bpmn:documentation>даты, ролики, аккаунты</bpmn:documentation><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-utv" name="Утвердить план, дальше не меняется"><bpmn:documentation>Андрей или София</bpmn:documentation><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:parallelGateway id="p1-gwp" name=""><bpmn:incoming>flow-6</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing><bpmn:outgoing>flow-8</bpmn:outgoing><bpmn:outgoing>flow-9</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:userTask id="p1-poisk" name="Набрать публикаторов под проект"><bpmn:documentation>сколько: по числу устройств</bpmn:documentation><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-akk" name="Создать аккаунты: своя почта, одно устройство"><bpmn:documentation>почты и номера у клиента не просим</bpmn:documentation><bpmn:incoming>flow-10</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-upak" name="Упаковать: имя, описание, заголовки, аватарка"><bpmn:documentation>ТЗ на упаковку: Настя</bpmn:documentation><bpmn:incoming>flow-11</bpmn:incoming><bpmn:outgoing>flow-12</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-progrev" name="Прогреть: подписки, просмотры, лайки"><bpmn:documentation>сколько дней: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-12</bpmn:incoming><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-mod" name="→ процесс 2: референсы, аватары, голоса"><bpmn:documentation>ТЗ и утверждение у Софии</bpmn:documentation><bpmn:incoming>flow-8</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-scen" name="→ процесс 3: сценарии на первую неделю"><bpmn:documentation>первые 2-3 показываем клиенту</bpmn:documentation><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p1-v-gw" name="Воронку делает клиент?"><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-17</bpmn:outgoing><bpmn:outgoing>flow-18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p1-teh" name="Кодовое слово, автоответ, бот"><bpmn:documentation>слово Насте и публикаторам</bpmn:documentation><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-19</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-kviz" name="Утвердить тему квиза вместе с клиентом"><bpmn:documentation>тема идет в призыв роликов</bpmn:documentation><bpmn:incoming>flow-18</bpmn:incoming><bpmn:outgoing>flow-20</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p1-v-j" name=""><bpmn:incoming>flow-19</bpmn:incoming><bpmn:incoming>flow-20</bpmn:incoming><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:parallelGateway id="p1-gwp-j" name=""><bpmn:incoming>flow-13</bpmn:incoming><bpmn:incoming>flow-14</bpmn:incoming><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-21</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:userTask id="p1-pervye" name="→ процессы 4 и 5: первый пакет роликов"><bpmn:documentation>хотя бы на пару дней</bpmn:documentation><bpmn:incoming>flow-21</bpmn:incoming><bpmn:outgoing>flow-22</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p1-gotov" name="Проверить готовность по списку двух недель"><bpmn:documentation>аватары, сценарий, монтаж, ролики, аккаунты</bpmn:documentation><bpmn:incoming>flow-22</bpmn:incoming><bpmn:outgoing>flow-23</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p1-end" name="Контур готов к выкладке"><bpmn:documentation>→ процесс 6</bpmn:documentation><bpmn:incoming>flow-23</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="p1-start" targetRef="p1-chat" />
<bpmn:sequenceFlow id="flow-1" sourceRef="p1-chat" targetRef="p1-k-sofii" />
