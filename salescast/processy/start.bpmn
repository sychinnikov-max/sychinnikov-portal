<bpmn:sequenceFlow id="flow-5" sourceRef="p1-plan" targetRef="p1-utv" />
<bpmn:sequenceFlow id="flow-6" sourceRef="p1-utv" targetRef="p1-gwp" />
<bpmn:sequenceFlow id="flow-7" sourceRef="p1-gwp" targetRef="p1-poisk" />
<bpmn:sequenceFlow id="flow-8" sourceRef="p1-gwp" targetRef="p1-mod" />
<bpmn:sequenceFlow id="flow-9" sourceRef="p1-gwp" targetRef="p1-v-gw" />
<bpmn:sequenceFlow id="flow-10" sourceRef="p1-poisk" targetRef="p1-akk" />
<bpmn:sequenceFlow id="flow-11" sourceRef="p1-akk" targetRef="p1-upak" />
<bpmn:sequenceFlow id="flow-12" sourceRef="p1-upak" targetRef="p1-progrev" />
<bpmn:sequenceFlow id="flow-13" sourceRef="p1-v-j" targetRef="p1-gwp-j" />
<bpmn:sequenceFlow id="flow-14" sourceRef="p1-progrev" targetRef="p1-gwp-j" />
<bpmn:sequenceFlow id="flow-15" sourceRef="p1-mod" targetRef="p1-scen" />
<bpmn:sequenceFlow id="flow-16" sourceRef="p1-scen" targetRef="p1-gwp-j" />
<bpmn:sequenceFlow id="flow-17" name="нет" sourceRef="p1-v-gw" targetRef="p1-teh" />
<bpmn:sequenceFlow id="flow-18" name="да" sourceRef="p1-v-gw" targetRef="p1-kviz" />
<bpmn:sequenceFlow id="flow-19" sourceRef="p1-teh" targetRef="p1-v-j" />
<bpmn:sequenceFlow id="flow-20" sourceRef="p1-kviz" targetRef="p1-v-j" />
<bpmn:sequenceFlow id="flow-21" sourceRef="p1-gwp-j" targetRef="p1-pervye" />
<bpmn:sequenceFlow id="flow-22" sourceRef="p1-pervye" targetRef="p1-gotov" />
<bpmn:sequenceFlow id="flow-23" sourceRef="p1-gotov" targetRef="p1-end" />
</bpmn:process>
<bpmn:process id="proc-client-start" isExecutable="false">
<bpmn:task id="p1-cl" name="Ответить на вопросы по проекту" />
<bpmn:task id="p1-cl-kviz" name="Сделать квиз, прислать варианты темы" />
</bpmn:process>
