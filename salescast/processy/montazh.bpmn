<bpmn:sequenceFlow id="flow-13" sourceRef="p5-j" targetRef="p5-end" />
<bpmn:sequenceFlow id="flow-14" sourceRef="p5-srok" targetRef="p5-kontrol" />
<bpmn:sequenceFlow id="flow-15" sourceRef="p5-kontrol" targetRef="p5-gw-srok" />
<bpmn:sequenceFlow id="flow-16" name="да" sourceRef="p5-gw-srok" targetRef="p5-end-ok" />
<bpmn:sequenceFlow id="flow-17" name="нет: написать Андрею" sourceRef="p5-gw-srok" targetRef="p5-razbor" />
<bpmn:sequenceFlow id="flow-18" sourceRef="p5-razbor" targetRef="p5-end-otkl" />
