<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-montazh" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-montazh">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-montazh" />
</bpmn:collaboration>
<bpmn:process id="proc-montazh" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-andrei" name="Андрей · управление">
<bpmn:flowNodeRef>task-kontrol</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end-mont</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-sofia" name="София · качество">
<bpmn:flowNodeRef>task-ok-tz</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-tz</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-priemka-mont</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-mont</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-nastya" name="Настя · производство">
<bpmn:flowNodeRef>start-scen</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-tz-mont</bpmn:flowNodeRef>
<bpmn:flowNodeRef>catch-12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-doslat</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-galochki</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-plan</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-ksyusha" name="Ксюша · оживление">
<bpmn:flowNodeRef>catch-ozhiv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-papka</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-kirill" name="Кирилл · монтаж">
<bpmn:flowNodeRef>task-montazh</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-v-papku</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-pub" name="Публикатор · выкладка">
<bpmn:flowNodeRef>task-vylozhit</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-otchet</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start-scen" name="Сценарии пачки утверждены (из процесса 2)"><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="task-tz-mont" name="Написать ТЗ на монтаж в таблице (по референсу; сейчас только Лувира)"><bpmn:incoming>flow-0</bpmn:incoming><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-ok-tz" name="Утвердить ТЗ на монтаж галочкой (ждет да Софии)"><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-tz" name="ТЗ ок?"><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="catch-ozhiv" name="Ролики дня оживлены (из процесса 1)"><bpmn:incoming>flow-3</bpmn:incoming><bpmn:incoming>flow-18</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing><bpmn:timerEventDefinition id="timer-catch-ozhiv" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="task-papka" name="Положить исходники, рефы и ТЗ в папку дня (до 12:00; сейчас в Телеграм)"><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="catch-12" name="12:00, папка пустая (таймер)"><bpmn:outgoing>flow-7</bpmn:outgoing><bpmn:timerEventDefinition id="timer-catch-12" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="task-doslat" name="Дослать исходники самой (Настя отвечает за Ксюшу)"><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-8</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-montazh" name="Смонтировать по ТЗ (субтитры, вставки, обложка)"><bpmn:incoming>flow-6</bpmn:incoming><bpmn:incoming>flow-8</bpmn:incoming><bpmn:incoming>flow-13</bpmn:incoming><bpmn:outgoing>flow-9</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-v-papku" name="Положить готовые видео в папку месяца (сейчас шлет в рабочий чат)"><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-priemka-mont" name="Принять монтаж и обложку (сейчас не всегда, правки задним числом)"><bpmn:incoming>flow-10</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-mont" name="Ок?"><bpmn:incoming>flow-11</bpmn:incoming><bpmn:outgoing>flow-12</bpmn:outgoing><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="task-vylozhit" name="Скачать из папки и выложить (1 аккаунт = 1 устройство)"><bpmn:incoming>flow-12</bpmn:incoming><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-otchet" name="Отчет к 19:00: дата, клиент, сколько, ссылка (сейчас бывает к полуночи)"><bpmn:incoming>flow-14</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-galochki" name="Сверить файлы и поставить галочки («смонтировано» и «выложено»)"><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-plan" name="План месяца закрыт?"><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-17</bpmn:outgoing><bpmn:outgoing>flow-18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="task-kontrol" name="Сверить объем по договору (таблица клиента, отчет клиенту)"><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-19</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="end-mont" name="Объем месяца выложен"><bpmn:incoming>flow-19</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="start-scen" targetRef="task-tz-mont" />
<bpmn:sequenceFlow id="flow-1" sourceRef="task-tz-mont" targetRef="task-ok-tz" />
<bpmn:sequenceFlow id="flow-2" sourceRef="task-ok-tz" targetRef="gw-tz" />
<bpmn:sequenceFlow id="flow-3" name="да" sourceRef="gw-tz" targetRef="catch-ozhiv" />
<bpmn:sequenceFlow id="flow-4" name="правки" sourceRef="gw-tz" targetRef="task-tz-mont" />
<bpmn:sequenceFlow id="flow-5" sourceRef="catch-ozhiv" targetRef="task-papka" />
<bpmn:sequenceFlow id="flow-6" sourceRef="task-papka" targetRef="task-montazh" />
<bpmn:sequenceFlow id="flow-7" sourceRef="catch-12" targetRef="task-doslat" />
<bpmn:sequenceFlow id="flow-8" name="исходники" sourceRef="task-doslat" targetRef="task-montazh" />
<bpmn:sequenceFlow id="flow-9" sourceRef="task-montazh" targetRef="task-v-papku" />
<bpmn:sequenceFlow id="flow-10" sourceRef="task-v-papku" targetRef="task-priemka-mont" />
<bpmn:sequenceFlow id="flow-11" sourceRef="task-priemka-mont" targetRef="gw-mont" />
<bpmn:sequenceFlow id="flow-12" name="да" sourceRef="gw-mont" targetRef="task-vylozhit" />
<bpmn:sequenceFlow id="flow-13" name="правки" sourceRef="gw-mont" targetRef="task-montazh" />
<bpmn:sequenceFlow id="flow-14" sourceRef="task-vylozhit" targetRef="task-otchet" />
<bpmn:sequenceFlow id="flow-15" sourceRef="task-otchet" targetRef="task-galochki" />
<bpmn:sequenceFlow id="flow-16" sourceRef="task-galochki" targetRef="gw-plan" />
<bpmn:sequenceFlow id="flow-17" name="да" sourceRef="gw-plan" targetRef="task-kontrol" />
<bpmn:sequenceFlow id="flow-18" name="нет, следующий день" sourceRef="gw-plan" targetRef="catch-ozhiv" />
<bpmn:sequenceFlow id="flow-19" sourceRef="task-kontrol" targetRef="end-mont" />
</bpmn:process>
