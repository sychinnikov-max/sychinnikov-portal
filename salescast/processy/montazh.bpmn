</bpmn:collaboration>
<bpmn:process id="proc-montazh" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-upravlenie" name="Управление · сейчас Андрей">
<bpmn:flowNodeRef>p5-razbor</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-end-otkl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-r-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-rezerv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-r-end</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-kachestvo" name="Продукт и качество · сейчас София">
<bpmn:flowNodeRef>p5-sof</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-gw-sofok</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-proizvodstvo" name="Производство · сейчас Настя">
<bpmn:flowNodeRef>p5-prov</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-gw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-pravki</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-gw-first</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-j</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-end</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-srok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-kontrol</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-gw-srok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-end-ok</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-montazh" name="Монтажеры · сейчас Кирилл">
<bpmn:flowNodeRef>p5-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-zabrat</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-mont</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p5-papka</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p5-start" name="Ссылка и ТЗ в таблице"><bpmn:documentation>из процесса 4</bpmn:documentation><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p5-zabrat" name="Забрать исходник и ТЗ по таблице"><bpmn:documentation>без пересылки в Телеграм</bpmn:documentation><bpmn:incoming>flow-0</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p5-mont" name="Смонтировать по ТЗ: субтитры, вставки, обложка"><bpmn:documentation>исходники к 11:00, сдача к 15-16</bpmn:documentation><bpmn:incoming>flow-1</bpmn:incoming><bpmn:incoming>flow-7</bpmn:incoming><bpmn:incoming>flow-12</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p5-papka" name="Готовое в папку, отметка «монтаж»"><bpmn:documentation>всегда на завтра</bpmn:documentation><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p5-prov" name="Проверить ролик по ТЗ"><bpmn:documentation>созвон с Софией 15.09</bpmn:documentation><bpmn:incoming>flow-3</bpmn:incoming><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p5-gw" name="Ок?"><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p5-pravki" name="Дать правки монтажеру"><bpmn:incoming>flow-6</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p5-gw-first" name="Первые ролики по клиенту?"><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-8</bpmn:outgoing><bpmn:outgoing>flow-9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p5-sof" name="Утвердить монтаж и обложку"><bpmn:documentation>соглашение; делим ли: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p5-gw-sofok" name="Ок?"><bpmn:incoming>flow-10</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing><bpmn:outgoing>flow-12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p5-j" name=""><bpmn:incoming>flow-8</bpmn:incoming><bpmn:incoming>flow-11</bpmn:incoming><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p5-end" name="Ролик готов к выкладке"><bpmn:documentation>→ процесс 6</bpmn:documentation><bpmn:incoming>flow-13</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="p5-srok" name="Срок сдачи: 15-16 часов"><bpmn:documentation>созвон с Софией 15.09</bpmn:documentation><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p5-kontrol" name="Проверить папку к сроку"><bpmn:documentation>созвон с Настей 15.09</bpmn:documentation><bpmn:incoming>flow-14</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p5-gw-srok" name="Все сдано?"><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing><bpmn:outgoing>flow-17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p5-end-ok" name="Сдано в срок"><bpmn:incoming>flow-16</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="p5-razbor" name="Разобрать с монтажером, записать срок"><bpmn:documentation>регламент: одно правило в неделю</bpmn:documentation><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-18</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p5-end-otkl" name="Срок в регламенте"><bpmn:incoming>flow-18</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="p5-r-start" name="Монтажер выпал"><bpmn:outgoing>flow-19</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p5-rezerv" name="Перекинуть объем на резервного монтажера"><bpmn:documentation>кто резервный: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-19</bpmn:incoming><bpmn:outgoing>flow-20</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p5-r-end" name="Объем перекинут"><bpmn:incoming>flow-20</bpmn:incoming></bpmn:endEvent>
