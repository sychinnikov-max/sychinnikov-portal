<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-prodlenie" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-prodlenie">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-prodlenie" />
<bpmn:participant id="pool-client" name="Клиент" processRef="proc-client-prodlenie" />
<bpmn:messageFlow id="msg-0" name="цифры недели" sourceRef="p7-w-send" targetRef="p7-w-cl" />
<bpmn:messageFlow id="msg-1" name="вопросы" sourceRef="p7-w-cl" targetRef="p7-w-send" />
<bpmn:messageFlow id="msg-2" name="итоги" sourceRef="p7-sozvon" targetRef="p7-cl-r" />
<bpmn:messageFlow id="msg-3" name="решение" sourceRef="p7-cl-r" targetRef="p7-sozvon" />
<bpmn:messageFlow id="msg-4" name="отчет и акт" sourceRef="p7-send" targetRef="p7-cl-akt" />
<bpmn:messageFlow id="msg-5" name="ответ" sourceRef="p7-cl-akt" targetRef="p7-send" />
</bpmn:collaboration>
<bpmn:process id="proc-prodlenie" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-menedzher" name="Менеджер клиента · сейчас Андрей">
<bpmn:flowNodeRef>p7-w-send</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-w-vopr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-w-end</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-otchet</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-send</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-gw-akt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-gw-final</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-end-new</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-dostupy</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-upravlenie" name="Управление · сейчас Андрей">
<bpmn:flowNodeRef>p7-w-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-w-cifry</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-p-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-cifry</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-predl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-sozvon</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-gw-prodl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-end-net</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-dop</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-end-prodl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-c-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-akt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-baza</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p7-end-close</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-kachestvo" name="Продукт и качество · сейчас София">
<bpmn:flowNodeRef>p7-expert</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-proizvodstvo" name="Производство · сейчас Настя">
<bpmn:flowNodeRef>p7-razbor</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p7-w-start" name="Неделя выкладки"><bpmn:documentation>частота: вопрос Софии</bpmn:documentation><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p7-w-cifry" name="Цифры недели: просмотры, кодовые слова"><bpmn:documentation>соглашение</bpmn:documentation><bpmn:incoming>flow-0</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="p7-w-send" name="Отчет или созвон клиенту, собрать вопросы"><bpmn:documentation>София подключается по продукту</bpmn:documentation><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="p7-w-vopr" name="Вопросы по продукту Софии, по контенту Насте"><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p7-w-end" name="Неделя закрыта"><bpmn:incoming>flow-3</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="p7-p-start" name="Пора говорить о продлении"><bpmn:documentation>за сколько дней: вопрос Софии</bpmn:documentation><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p7-cifry" name="Собрать цифры периода"><bpmn:documentation>просмотры, кодовые слова</bpmn:documentation><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p7-razbor" name="Что сработало: форматы и сценарии"><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p7-expert" name="Продуктовая часть нового периода"><bpmn:documentation>соглашение</bpmn:documentation><bpmn:incoming>flow-6</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p7-predl" name="Состав, цена и что продать сверху, вдвоем"><bpmn:documentation>организует Андрей</bpmn:documentation><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-8</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="p7-sozvon" name="Созвон с клиентом: итоги и новый период"><bpmn:documentation>цель: вести клиента не один месяц</bpmn:documentation><bpmn:incoming>flow-8</bpmn:incoming><bpmn:outgoing>flow-9</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="p7-gw-prodl" name="Продлевает?"><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-10</bpmn:outgoing><bpmn:outgoing>flow-11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p7-end-net" name="Без продления"><bpmn:documentation>закрытие по объему</bpmn:documentation><bpmn:incoming>flow-11</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="p7-dop" name="Допсоглашение и счет в работу"><bpmn:documentation>подписать за 10 дней до конца</bpmn:documentation><bpmn:incoming>flow-10</bpmn:incoming><bpmn:outgoing>flow-12</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p7-end-prodl" name="Новый договор в процесс 0"><bpmn:incoming>flow-12</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="p7-c-start" name="Объем выложен"><bpmn:documentation>из процесса 6</bpmn:documentation><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p7-otchet" name="Итоговый отчет: просмотры и кодовые слова"><bpmn:documentation>соглашение</bpmn:documentation><bpmn:incoming>flow-13</bpmn:incoming><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p7-akt" name="Акт или УПД по факту услуг"><bpmn:documentation>5 рабочих дней по договору</bpmn:documentation><bpmn:incoming>flow-14</bpmn:incoming><bpmn:incoming>flow-18</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="p7-send" name="Отправить отчет и акт, получить ответ"><bpmn:documentation>кто отправляет: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="p7-gw-akt" name="Акт подписан?"><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-17</bpmn:outgoing><bpmn:outgoing>flow-18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p7-gw-final" name="Новый период идет?"><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-19</bpmn:outgoing><bpmn:outgoing>flow-20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p7-end-new" name="Новый период идет"><bpmn:documentation>старт по процессу 1</bpmn:documentation><bpmn:incoming>flow-19</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="p7-dostupy" name="Передать клиенту аккаунты и доступы"><bpmn:documentation>кто и когда: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-20</bpmn:incoming><bpmn:outgoing>flow-21</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p7-baza" name="Внести клиента в базу, греть дальше"><bpmn:documentation>Андрей и София</bpmn:documentation><bpmn:incoming>flow-21</bpmn:incoming><bpmn:outgoing>flow-22</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p7-end-close" name="Контракт закрыт"><bpmn:incoming>flow-22</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="p7-w-start" targetRef="p7-w-cifry" />
<bpmn:sequenceFlow id="flow-1" sourceRef="p7-w-cifry" targetRef="p7-w-send" />
