<bpmn:sequenceFlow id="flow-5" sourceRef="p7-cifry" targetRef="p7-razbor" />
<bpmn:sequenceFlow id="flow-6" sourceRef="p7-razbor" targetRef="p7-expert" />
<bpmn:sequenceFlow id="flow-7" sourceRef="p7-expert" targetRef="p7-predl" />
<bpmn:sequenceFlow id="flow-8" sourceRef="p7-predl" targetRef="p7-sozvon" />
<bpmn:sequenceFlow id="flow-9" sourceRef="p7-sozvon" targetRef="p7-gw-prodl" />
<bpmn:sequenceFlow id="flow-10" name="да" sourceRef="p7-gw-prodl" targetRef="p7-dop" />
<bpmn:sequenceFlow id="flow-11" name="нет" sourceRef="p7-gw-prodl" targetRef="p7-end-net" />
<bpmn:sequenceFlow id="flow-12" sourceRef="p7-dop" targetRef="p7-end-prodl" />
<bpmn:sequenceFlow id="flow-13" sourceRef="p7-c-start" targetRef="p7-otchet" />
<bpmn:sequenceFlow id="flow-14" sourceRef="p7-otchet" targetRef="p7-akt" />
<bpmn:sequenceFlow id="flow-15" sourceRef="p7-akt" targetRef="p7-send" />
<bpmn:sequenceFlow id="flow-16" sourceRef="p7-send" targetRef="p7-gw-akt" />
<bpmn:sequenceFlow id="flow-17" name="да" sourceRef="p7-gw-akt" targetRef="p7-gw-final" />
<bpmn:sequenceFlow id="flow-18" name="отказ, правки" sourceRef="p7-gw-akt" targetRef="p7-akt" />
<bpmn:sequenceFlow id="flow-19" name="да" sourceRef="p7-gw-final" targetRef="p7-end-new" />
<bpmn:sequenceFlow id="flow-20" name="нет" sourceRef="p7-gw-final" targetRef="p7-dostupy" />
<bpmn:sequenceFlow id="flow-21" sourceRef="p7-dostupy" targetRef="p7-baza" />
<bpmn:sequenceFlow id="flow-22" sourceRef="p7-baza" targetRef="p7-end-close" />
</bpmn:process>
