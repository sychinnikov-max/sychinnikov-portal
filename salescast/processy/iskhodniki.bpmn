<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-iskhodniki" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-iskhodniki">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-iskhodniki" />
</bpmn:collaboration>
<bpmn:process id="proc-iskhodniki" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-upravlenie" name="Управление · сейчас Андрей">
<bpmn:flowNodeRef>p4-popoln</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-otkl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-end-otkl</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-proizvodstvo" name="Производство · сейчас Настя">
<bpmn:flowNodeRef>p4-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-zadacha</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-tokeny</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-gw-tok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-srok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-kontrol</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-gw-srok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-end-ok</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-iskhodniki" name="Помощник по исходникам · сейчас Ксюша">
<bpmn:flowNodeRef>p4-ozhiv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-prov</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-gw-err</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-regen</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-disk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-tabl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p4-end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p4-start" name="Сценарии утверждены"><bpmn:documentation>из процесса 3</bpmn:documentation><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p4-zadacha" name="Передать сценарии и ТЗ помощнику"><bpmn:documentation>задача в CRM со сроком, 11.09</bpmn:documentation><bpmn:incoming>flow-0</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p4-tokeny" name="Проверить остаток токенов HeyGen"><bpmn:documentation>предупредить примерно за 40 роликов</bpmn:documentation><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p4-gw-tok" name="Хватит?"><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p4-popoln" name="Пополнить HeyGen по задаче в CRM"><bpmn:documentation>срок: следующий рабочий день</bpmn:documentation><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p4-ozhiv" name="Оживить аватаров, собрать аудио"><bpmn:documentation>на пару дней вперед</bpmn:documentation><bpmn:incoming>flow-3</bpmn:incoming><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p4-prov" name="Проверить ударения, мимику, артефакты"><bpmn:documentation>созвон с Настей 15.09</bpmn:documentation><bpmn:incoming>flow-6</bpmn:incoming><bpmn:incoming>flow-10</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p4-gw-err" name="Ошибки?"><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-8</bpmn:outgoing><bpmn:outgoing>flow-9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p4-regen" name="Перегенерировать, поправить ударения"><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p4-disk" name="Выгрузить исходник на Google Диск"><bpmn:documentation>механику продумывает Андрей</bpmn:documentation><bpmn:incoming>flow-8</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p4-tabl" name="Ссылка и ТЗ в таблицу, отметка «видео готово»"><bpmn:documentation>монтажер забирает сам</bpmn:documentation><bpmn:incoming>flow-11</bpmn:incoming><bpmn:outgoing>flow-12</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p4-end" name="Исходники у монтажера"><bpmn:documentation>→ процесс 5</bpmn:documentation><bpmn:incoming>flow-12</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="p4-srok" name="Срок: исходники к 11:00"><bpmn:documentation>созвон с Софией 15.09</bpmn:documentation><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p4-kontrol" name="Проверить таблицу к сроку"><bpmn:documentation>созвон с Настей 15.09</bpmn:documentation><bpmn:incoming>flow-13</bpmn:incoming><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p4-gw-srok" name="Все на месте?"><bpmn:incoming>flow-14</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing><bpmn:outgoing>flow-16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="p4-end-ok" name="Сдано в срок"><bpmn:incoming>flow-15</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="p4-otkl" name="Разобрать отклонение"><bpmn:documentation>досылает ли Настя сама: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-17</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p4-end-otkl" name="Отклонение разобрано"><bpmn:incoming>flow-17</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="p4-start" targetRef="p4-zadacha" />
<bpmn:sequenceFlow id="flow-1" sourceRef="p4-zadacha" targetRef="p4-tokeny" />
<bpmn:sequenceFlow id="flow-2" sourceRef="p4-tokeny" targetRef="p4-gw-tok" />
<bpmn:sequenceFlow id="flow-3" name="да" sourceRef="p4-gw-tok" targetRef="p4-ozhiv" />
<bpmn:sequenceFlow id="flow-4" name="нет" sourceRef="p4-gw-tok" targetRef="p4-popoln" />
<bpmn:sequenceFlow id="flow-5" sourceRef="p4-popoln" targetRef="p4-ozhiv" />
<bpmn:sequenceFlow id="flow-6" sourceRef="p4-ozhiv" targetRef="p4-prov" />
<bpmn:sequenceFlow id="flow-7" sourceRef="p4-prov" targetRef="p4-gw-err" />
<bpmn:sequenceFlow id="flow-8" name="нет" sourceRef="p4-gw-err" targetRef="p4-disk" />
<bpmn:sequenceFlow id="flow-9" name="да" sourceRef="p4-gw-err" targetRef="p4-regen" />
<bpmn:sequenceFlow id="flow-10" sourceRef="p4-regen" targetRef="p4-prov" />
<bpmn:sequenceFlow id="flow-11" sourceRef="p4-disk" targetRef="p4-tabl" />
<bpmn:sequenceFlow id="flow-12" sourceRef="p4-tabl" targetRef="p4-end" />
<bpmn:sequenceFlow id="flow-13" sourceRef="p4-srok" targetRef="p4-kontrol" />
<bpmn:sequenceFlow id="flow-14" sourceRef="p4-kontrol" targetRef="p4-gw-srok" />
<bpmn:sequenceFlow id="flow-15" name="да" sourceRef="p4-gw-srok" targetRef="p4-end-ok" />
<bpmn:sequenceFlow id="flow-16" name="нет: написать Андрею" sourceRef="p4-gw-srok" targetRef="p4-otkl" />
<bpmn:sequenceFlow id="flow-17" sourceRef="p4-otkl" targetRef="p4-end-otkl" />
</bpmn:process>
