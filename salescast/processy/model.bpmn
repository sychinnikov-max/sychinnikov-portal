<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-model" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-model">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-model" />
<bpmn:participant id="pool-client" name="Клиент" processRef="proc-client-model" />
<bpmn:messageFlow id="msg-0" name="модель на согласование" sourceRef="task-send-m" targetRef="task-client-m" />
<bpmn:messageFlow id="msg-1" name="ответ клиента" sourceRef="task-client-m" targetRef="task-send-m" />
<bpmn:messageFlow id="msg-2" name="голос на согласование" sourceRef="task-send-g" targetRef="task-client-g" />
</bpmn:collaboration>
<bpmn:process id="proc-model" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-andrei" name="Андрей · управление">
<bpmn:flowNodeRef>start-dogovor</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-brief</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-kontur</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-tz-model</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-popoln</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-sofia" name="София · качество">
<bpmn:flowNodeRef>task-spor</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-nastya" name="Настя · производство">
<bpmn:flowNodeRef>gw-foto</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-po-foto</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-podbor</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-foto-join</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-generate</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-priemka-m</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-send-m</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-client-m</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-golos</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-send-g</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-par-split</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-avatarka</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-tz-akk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-instr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-par-join</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-tokeny</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw-tokeny</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-ksyusha" name="Ксюша · оживление">
<bpmn:flowNodeRef>catch-scen</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-ozhiv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>task-udar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end-model</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start-dogovor" name="Договор подписан, оплата пришла"><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="task-brief" name="Собрать бриф и карточку клиента (шаблон брифа: ниша, продукт, темы, запреты)"><bpmn:incoming>flow-0</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-kontur" name="Завести чат, проект в CRM, папки и таблицу (чат: клиент, его менеджер, София, Андрей, Настя)"><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-tz-model" name="Поставить Насте задачу в CRM на модель (со сроком, сейчас устно)"><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-foto" name="Клиент дал фото?"><bpmn:incoming>flow-3</bpmn:incoming><bpmn:outgoing>flow-4</bpmn:outgoing><bpmn:outgoing>flow-5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="task-po-foto" name="Сделать модель по фото клиента"><bpmn:incoming>flow-4</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-podbor" name="Подобрать образ, фон, ракурсы"><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-foto-join" name=""><bpmn:incoming>flow-6</bpmn:incoming><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="task-generate" name="Сгенерировать варианты модели в GPT (≈2 часа на клиента)"><bpmn:incoming>flow-8</bpmn:incoming><bpmn:incoming>flow-13</bpmn:incoming><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-9</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-priemka-m" name="Принять модель по качеству (решение 11.09: без Софии)"><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="task-send-m" name="Отправить модель клиенту в чат (напрямую, решение 11.09)"><bpmn:incoming>flow-10</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="gw-client-m" name="Ответ клиента?"><bpmn:incoming>flow-11</bpmn:incoming><bpmn:outgoing>flow-12</bpmn:outgoing><bpmn:outgoing>flow-13</bpmn:outgoing><bpmn:outgoing>flow-14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="task-spor" name="Решить спорную правку клиента (правки во вред результату не берем)"><bpmn:incoming>flow-14</bpmn:incoming><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-golos" name="Сделать голос в HeyGen (ElevenLabs не подключен)"><bpmn:incoming>flow-12</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing></bpmn:userTask>
<bpmn:sendTask id="task-send-g" name="Согласовать голос с клиентом (напрямую, решение 11.09)"><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-17</bpmn:outgoing></bpmn:sendTask>
<bpmn:parallelGateway id="gw-par-split" name=""><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-18</bpmn:outgoing><bpmn:outgoing>flow-19</bpmn:outgoing><bpmn:outgoing>flow-20</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:userTask id="task-avatarka" name="Сделать аватарку для аккаунта (сейчас лицо на белом фоне)"><bpmn:incoming>flow-18</bpmn:incoming><bpmn:outgoing>flow-21</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-tz-akk" name="Дать публикаторам ТЗ на имя и упаковку (было на Андрее, забрала Настя)"><bpmn:incoming>flow-19</bpmn:incoming><bpmn:outgoing>flow-22</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-instr" name="Описать инструкцию по оживлению (условие передачи Ксюше)"><bpmn:incoming>flow-20</bpmn:incoming><bpmn:outgoing>flow-23</bpmn:outgoing></bpmn:userTask>
<bpmn:parallelGateway id="gw-par-join" name=""><bpmn:incoming>flow-21</bpmn:incoming><bpmn:incoming>flow-22</bpmn:incoming><bpmn:incoming>flow-23</bpmn:incoming><bpmn:outgoing>flow-24</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:intermediateCatchEvent id="catch-scen" name="Сценарии дня утверждены (из процесса 2)"><bpmn:incoming>flow-24</bpmn:incoming><bpmn:outgoing>flow-25</bpmn:outgoing><bpmn:timerEventDefinition id="timer-catch-scen" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="task-tokeny" name="Проверить остаток токенов HeyGen (порог ≈40 роликов)"><bpmn:incoming>flow-25</bpmn:incoming><bpmn:outgoing>flow-26</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw-tokeny" name="Хватит?"><bpmn:incoming>flow-26</bpmn:incoming><bpmn:outgoing>flow-27</bpmn:outgoing><bpmn:outgoing>flow-28</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="task-popoln" name="Пополнить HeyGen по задаче в CRM (срок: следующий рабочий день)"><bpmn:incoming>flow-28</bpmn:incoming><bpmn:outgoing>flow-29</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-ozhiv" name="Оживить ролики дня в HeyGen (только то, что идет на выкладку)"><bpmn:incoming>flow-27</bpmn:incoming><bpmn:incoming>flow-29</bpmn:incoming><bpmn:outgoing>flow-30</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="task-udar" name="Прослушать ударения и поправить (20-25 роликов ≈ 1,5 ч)"><bpmn:incoming>flow-30</bpmn:incoming><bpmn:outgoing>flow-31</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="end-model" name="Ролики готовы к монтажу (→ процесс 3)"><bpmn:incoming>flow-31</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="start-dogovor" targetRef="task-brief" />
<bpmn:sequenceFlow id="flow-1" sourceRef="task-brief" targetRef="task-kontur" />
<bpmn:sequenceFlow id="flow-2" sourceRef="task-kontur" targetRef="task-tz-model" />
<bpmn:sequenceFlow id="flow-3" sourceRef="task-tz-model" targetRef="gw-foto" />
<bpmn:sequenceFlow id="flow-4" name="да" sourceRef="gw-foto" targetRef="task-po-foto" />
<bpmn:sequenceFlow id="flow-5" name="нет" sourceRef="gw-foto" targetRef="task-podbor" />
<bpmn:sequenceFlow id="flow-6" sourceRef="task-po-foto" targetRef="gw-foto-join" />
<bpmn:sequenceFlow id="flow-7" sourceRef="task-podbor" targetRef="gw-foto-join" />
<bpmn:sequenceFlow id="flow-8" sourceRef="gw-foto-join" targetRef="task-generate" />
<bpmn:sequenceFlow id="flow-9" sourceRef="task-generate" targetRef="task-priemka-m" />
<bpmn:sequenceFlow id="flow-10" sourceRef="task-priemka-m" targetRef="task-send-m" />
<bpmn:sequenceFlow id="flow-11" sourceRef="task-send-m" targetRef="gw-client-m" />
<bpmn:sequenceFlow id="flow-12" name="утвердил" sourceRef="gw-client-m" targetRef="task-golos" />
<bpmn:sequenceFlow id="flow-13" name="правки" sourceRef="gw-client-m" targetRef="task-generate" />
<bpmn:sequenceFlow id="flow-14" name="спорная" sourceRef="gw-client-m" targetRef="task-spor" />
<bpmn:sequenceFlow id="flow-15" sourceRef="task-spor" targetRef="task-generate" />
<bpmn:sequenceFlow id="flow-16" sourceRef="task-golos" targetRef="task-send-g" />
<bpmn:sequenceFlow id="flow-17" sourceRef="task-send-g" targetRef="gw-par-split" />
<bpmn:sequenceFlow id="flow-18" sourceRef="gw-par-split" targetRef="task-avatarka" />
<bpmn:sequenceFlow id="flow-19" sourceRef="gw-par-split" targetRef="task-tz-akk" />
<bpmn:sequenceFlow id="flow-20" sourceRef="gw-par-split" targetRef="task-instr" />
<bpmn:sequenceFlow id="flow-21" sourceRef="task-avatarka" targetRef="gw-par-join" />
<bpmn:sequenceFlow id="flow-22" sourceRef="task-tz-akk" targetRef="gw-par-join" />
<bpmn:sequenceFlow id="flow-23" sourceRef="task-instr" targetRef="gw-par-join" />
<bpmn:sequenceFlow id="flow-24" sourceRef="gw-par-join" targetRef="catch-scen" />
<bpmn:sequenceFlow id="flow-25" sourceRef="catch-scen" targetRef="task-tokeny" />
<bpmn:sequenceFlow id="flow-26" sourceRef="task-tokeny" targetRef="gw-tokeny" />
<bpmn:sequenceFlow id="flow-27" name="да" sourceRef="gw-tokeny" targetRef="task-ozhiv" />
<bpmn:sequenceFlow id="flow-28" name="нет" sourceRef="gw-tokeny" targetRef="task-popoln" />
<bpmn:sequenceFlow id="flow-29" sourceRef="task-popoln" targetRef="task-ozhiv" />
<bpmn:sequenceFlow id="flow-30" sourceRef="task-ozhiv" targetRef="task-udar" />
<bpmn:sequenceFlow id="flow-31" sourceRef="task-udar" targetRef="end-model" />
</bpmn:process>
<bpmn:process id="proc-client-model" isExecutable="false">
<bpmn:task id="task-client-m" name="Посмотреть модель, дать правки" />
<bpmn:task id="task-client-g" name="Утвердить голос" />
</bpmn:process>
