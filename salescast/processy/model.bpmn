<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions-model" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="collab-model">
<bpmn:participant id="pool-salescast" name="Salescast" processRef="proc-model" />
<bpmn:participant id="pool-client" name="Клиент" processRef="proc-client-model" />
<bpmn:messageFlow id="msg-0" name="аватар и голоса" sourceRef="p2-send" targetRef="p2-cl" />
<bpmn:messageFlow id="msg-1" name="ответ" sourceRef="p2-cl" targetRef="p2-send" />
</bpmn:collaboration>
<bpmn:process id="proc-model" isExecutable="false">
<bpmn:laneSet id="laneset-1">
<bpmn:lane id="lane-menedzher" name="Менеджер клиента · сейчас Андрей">
<bpmn:flowNodeRef>p2-send</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-gw-otv</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-kachestvo" name="Продукт и качество · сейчас София">
<bpmn:flowNodeRef>p2-reglament</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-baza</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-tz</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-den</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-utv</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-gw-ok</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-gw-cl</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-cl-j</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="lane-proizvodstvo" name="Производство · сейчас Настя">
<bpmn:flowNodeRef>p2-start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-ref</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-model</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-golos</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-avatarka</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-instr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>p2-end</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="p2-start" name="Проект стартовал"><bpmn:documentation>из процесса 1</bpmn:documentation><bpmn:outgoing>flow-0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="p2-reglament" name="Регламент сбора референсов, один раз"><bpmn:documentation>критерий: разговорный ролик</bpmn:documentation><bpmn:incoming>flow-0</bpmn:incoming><bpmn:outgoing>flow-1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p2-baza" name="Поднять базу референсов прошлых проектов"><bpmn:documentation>чтобы не искать заново</bpmn:documentation><bpmn:incoming>flow-1</bpmn:incoming><bpmn:outgoing>flow-2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p2-ref" name="Собрать около 50 разговорных роликов"><bpmn:documentation>кто собирает: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-2</bpmn:incoming><bpmn:outgoing>flow-3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p2-tz" name="Отсмотреть референсы, дать ТЗ на аватары"><bpmn:documentation>сколько, мужчины и женщины, образ</bpmn:documentation><bpmn:incoming>flow-3</bpmn:incoming><bpmn:outgoing>flow-4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p2-model" name="Модель: фото, по одному на аватар"><bpmn:documentation>три варианта, если договорились</bpmn:documentation><bpmn:incoming>flow-4</bpmn:incoming><bpmn:incoming>flow-10</bpmn:incoming><bpmn:incoming>flow-15</bpmn:incoming><bpmn:outgoing>flow-5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p2-golos" name="Голос: найти живой голос, загрузить в сервис"><bpmn:documentation>второй сервис: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-5</bpmn:incoming><bpmn:outgoing>flow-6</bpmn:outgoing></bpmn:userTask>
<bpmn:intermediateCatchEvent id="p2-den" name="День утверждений"><bpmn:documentation>пн, ср, пт</bpmn:documentation><bpmn:incoming>flow-6</bpmn:incoming><bpmn:outgoing>flow-7</bpmn:outgoing><bpmn:timerEventDefinition id="timer-p2-den" /></bpmn:intermediateCatchEvent>
<bpmn:userTask id="p2-utv" name="Утвердить аватаров и голоса"><bpmn:documentation>созвон с Софией 15.09</bpmn:documentation><bpmn:incoming>flow-7</bpmn:incoming><bpmn:outgoing>flow-8</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="p2-gw-ok" name="Ок?"><bpmn:incoming>flow-8</bpmn:incoming><bpmn:outgoing>flow-9</bpmn:outgoing><bpmn:outgoing>flow-10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p2-gw-cl" name="Показываем клиенту?"><bpmn:incoming>flow-9</bpmn:incoming><bpmn:outgoing>flow-11</bpmn:outgoing><bpmn:outgoing>flow-12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="p2-send" name="Показать клиенту: сначала картинка, потом голоса"><bpmn:documentation>решаем по клиенту</bpmn:documentation><bpmn:incoming>flow-12</bpmn:incoming><bpmn:outgoing>flow-13</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="p2-gw-otv" name="Ответ?"><bpmn:incoming>flow-13</bpmn:incoming><bpmn:outgoing>flow-14</bpmn:outgoing><bpmn:outgoing>flow-15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="p2-cl-j" name=""><bpmn:incoming>flow-11</bpmn:incoming><bpmn:incoming>flow-14</bpmn:incoming><bpmn:outgoing>flow-16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="p2-avatarka" name="Аватарка аккаунта по утвержденному персонажу"><bpmn:documentation>→ публикаторам, процесс 1</bpmn:documentation><bpmn:incoming>flow-16</bpmn:incoming><bpmn:outgoing>flow-17</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="p2-instr" name="Инструкция аватара для оживления"><bpmn:documentation>кто вносит в таблицу: вопрос Софии</bpmn:documentation><bpmn:incoming>flow-17</bpmn:incoming><bpmn:outgoing>flow-18</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="p2-end" name="Персонаж утвержден"><bpmn:documentation>→ процессы 3 и 4</bpmn:documentation><bpmn:incoming>flow-18</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow-0" sourceRef="p2-start" targetRef="p2-reglament" />
<bpmn:sequenceFlow id="flow-1" sourceRef="p2-reglament" targetRef="p2-baza" />
<bpmn:sequenceFlow id="flow-2" sourceRef="p2-baza" targetRef="p2-ref" />
<bpmn:sequenceFlow id="flow-3" sourceRef="p2-ref" targetRef="p2-tz" />
<bpmn:sequenceFlow id="flow-4" sourceRef="p2-tz" targetRef="p2-model" />
<bpmn:sequenceFlow id="flow-5" sourceRef="p2-model" targetRef="p2-golos" />
<bpmn:sequenceFlow id="flow-6" sourceRef="p2-golos" targetRef="p2-den" />
<bpmn:sequenceFlow id="flow-7" sourceRef="p2-den" targetRef="p2-utv" />
<bpmn:sequenceFlow id="flow-8" sourceRef="p2-utv" targetRef="p2-gw-ok" />
<bpmn:sequenceFlow id="flow-9" name="да" sourceRef="p2-gw-ok" targetRef="p2-gw-cl" />
<bpmn:sequenceFlow id="flow-10" name="нет, переделать" sourceRef="p2-gw-ok" targetRef="p2-model" />
<bpmn:sequenceFlow id="flow-11" name="нет" sourceRef="p2-gw-cl" targetRef="p2-cl-j" />
<bpmn:sequenceFlow id="flow-12" name="да" sourceRef="p2-gw-cl" targetRef="p2-send" />
<bpmn:sequenceFlow id="flow-13" sourceRef="p2-send" targetRef="p2-gw-otv" />
<bpmn:sequenceFlow id="flow-14" name="утвердил" sourceRef="p2-gw-otv" targetRef="p2-cl-j" />
<bpmn:sequenceFlow id="flow-15" name="правки" sourceRef="p2-gw-otv" targetRef="p2-model" />
<bpmn:sequenceFlow id="flow-16" sourceRef="p2-cl-j" targetRef="p2-avatarka" />
<bpmn:sequenceFlow id="flow-17" sourceRef="p2-avatarka" targetRef="p2-instr" />
<bpmn:sequenceFlow id="flow-18" sourceRef="p2-instr" targetRef="p2-end" />
</bpmn:process>
<bpmn:process id="proc-client-model" isExecutable="false">
<bpmn:task id="p2-cl" name="Посмотреть, дать реакцию или правки" />
</bpmn:process>
